# ---------------------------------------------------------------------------
# Firebase — SDK de cliente (navegador). PÚBLICAS por diseño.
# Lo que protege los datos son las Security Rules, no estas claves.
# Consola de Firebase → Configuración del proyecto → Tus apps → App web.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase — Admin SDK (servidor). SECRETAS. NUNCA con prefijo NEXT_PUBLIC_.
# Consola de Firebase → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada (descarga un JSON).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegar el valor "private_key" del JSON tal cual, entre comillas dobles.
# Trae saltos de línea escritos como \n; el código los convierte al cargar.
FIREBASE_PRIVATE_KEY=""
